# Twilio emergency calling (optional)
TWILIO_SID=
TWILIO_AUTH=
TWILIO_PHONE=

# SMTP email commands (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# Seconds to wait for WhatsApp Web before pressing Send
WHATSAPP_SEND_DELAY=12

# TinyFish API key for the Web panel: answer cards and the clean reader
# (optional; uses the free Search and Fetch tiers). Get one at
# https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=
